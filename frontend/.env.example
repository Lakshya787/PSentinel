# --- Pashu Sentinel - Frontend Environment Template --------------------------
# Copy this file to .env (for dev) or .env.production (for prod builds).
# NEVER commit .env or .env.production to git.

# --- Backend API URL ---------------------------------------------------------
# Leave BLANK for local development (Vite dev proxy auto-forwards to port 8000).
# In production, set this to the full URL of your deployed backend:
#   e.g. https://pashu-sentinel-api.onrender.com
VITE_API_URL=
