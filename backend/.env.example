# ─── Pashu Sentinel — Backend Environment Template ───────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Supabase project meta (public, used for auth)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXX
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXX
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ─── PostgreSQL / PostGIS connection (session pooler, port 5432) ──────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Use the "Session pooler" URI (port 5432), NOT the transaction pooler (6543).
# Replace [PASSWORD] with your actual DB password.
#
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
