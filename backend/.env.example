# --- Pashu Sentinel - Backend Environment Template ---------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it is gitignored).

# --- Database (SQLite - default, zero-server) ---------------------------------
# Leave DATABASE_URL unset to use the default SQLite file at backend/pashu_sentinel.db
# DATABASE_URL=sqlite:///./pashu_sentinel.db

# --- Database (PostgreSQL / PostGIS - for scaling) ---------------------------
# Uncomment and set if you want to use PostgreSQL instead of SQLite.
# Local Docker (see docker-compose.yml):
#   DATABASE_URL=postgresql+psycopg://pashu:pashu_dev_password@localhost:5433/pashu_sentinel
# Supabase session pooler:
#   DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# --- Auth (JWT) ---------------------------------------------------------------
# REQUIRED in production - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_python_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI / RAG -----------------------------------------------------------------
# REQUIRED - get your free Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# REQUIRED - get your free Groq key at https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# --- CORS ---------------------------------------------------------------------
# In production, set this to the full URL(s) of your deployed frontend.
# Comma-separated for multiple origins:
#   CORS_ORIGINS=https://pashu.example.com,https://www.pashu.example.com
# Leave unset for local development (localhost is allowed automatically).
# CORS_ORIGINS=

# --- Engine behaviour ---------------------------------------------------------
ENVIRONMENT=development
# Set to "production" on your hosting platform
# ENVIRONMENT=production
DB_ECHO=0
