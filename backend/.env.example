# ─── Pashu Sentinel — Backend Environment Template ───────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── PostgreSQL / PostGIS connection ──────────────────────────────────────────
#
# DATABASE_URL is read first. If absent, db.py assembles the URL from the
# individual DB_* vars below (Option B — useful in Docker Compose / k8s).
#
# Option A — Single URL (recommended for local dev)
#   Local Docker  : docker compose up -d  (see backend/docker-compose.yml)
#   DATABASE_URL=postgresql+psycopg://pashu:pashu_dev_password@localhost:5433/pashu_sentinel
#
#   Supabase session pooler (port 5432):
#     Get from: Supabase Dashboard → Settings → Database → Connection string → Session mode
#     Username MUST be postgres.PROJECTREF (not just postgres)
#   DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql+psycopg://pashu:pashu_dev_password@localhost:5433/pashu_sentinel

# Option B — Component vars (used only when DATABASE_URL is absent)
#   Defaults shown match the local docker-compose.yml service.
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=pashu_sentinel
# DB_USER=pashu
# DB_PASS=pashu_dev_password

# ─── Engine behaviour ─────────────────────────────────────────────────────────
# ENVIRONMENT=development   # set to "production" to expand the connection pool
# DB_ECHO=0                 # set to "1" to log every SQL statement to stderr

# ─── Supabase project meta (public, used for auth — optional for local dev) ───
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXX
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXX
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
